<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>بوابة الجهاز — دخول سريع</title>

<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#14110d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="بوابة الجهاز">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #14110d;
    --panel: #1f1a14;
    --panel-2: #241d15;
    --border: #3a2f22;
    --text: #f2e9dc;
    --muted: #8f8474;
    --accent: #e8a33d;
    --accent-soft: rgba(232, 163, 61, .16);
    --danger: #e2574c;
    --radius: 22px;
  }

  * { box-sizing: border-box; }

  html, body {
    height: 100%;
    margin: 0;
  }

  body {
    background:
      radial-gradient(120% 90% at 50% -10%, #241d15 0%, var(--bg) 55%);
    color: var(--text);
    font-family: "Space Grotesk", -apple-system, "Segoe UI", Tahoma, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 24px 18px calc(24px + env(safe-area-inset-bottom));
  }

  .stage {
    width: 100%;
    max-width: 380px;
  }

  .panel {
    position: relative;
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px 26px 26px;
    box-shadow: 0 30px 60px -30px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.03);
    overflow: hidden;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: -40% -20% auto -20%;
    height: 220px;
    background: radial-gradient(closest-side, var(--accent-soft), transparent 70%);
    pointer-events: none;
  }

  .eyebrow {
    position: relative;
    margin: 0 0 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: .16em;
    color: var(--accent);
    text-transform: uppercase;
  }

  h1 {
    position: relative;
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lede {
    position: relative;
    margin: 0 0 26px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .dial-frame {
    position: relative;
    background: #100d0a;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 12px;
    margin-bottom: 8px;
  }

  .dial-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: .1em;
    color: var(--muted);
    text-transform: uppercase;
    margin: 0 0 10px;
    display: block;
  }

  .dial-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    direction: ltr; /* عناوين IP تُقرأ دوماً من اليسار لليمين، حتى داخل صفحة RTL */
  }

  .octet {
    width: 100%;
    max-width: 54px;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--border);
    color: var(--text);
    font-family: "JetBrains Mono", monospace;
    font-size: 22px;
    font-weight: 700;
    text-align: center;
    padding: 4px 2px 8px;
    transition: border-color .15s ease, text-shadow .15s ease;
  }

  .octet:focus {
    outline: none;
    border-color: var(--accent);
    text-shadow: 0 0 14px var(--accent-soft);
  }

  .octet.invalid {
    border-color: var(--danger);
  }

  .dot {
    color: var(--muted);
    font-weight: 700;
    font-size: 18px;
    padding-bottom: 8px;
  }

  .port-tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--muted);
    padding-bottom: 8px;
    margin-inline-start: 4px;
    white-space: nowrap;
  }

  .hint {
    margin: 10px 2px 0;
    font-size: 12px;
    color: var(--muted);
    min-height: 16px;
  }

  .hint.error { color: var(--danger); }

  .tune-btn {
    position: relative;
    width: 100%;
    margin-top: 22px;
    padding: 15px 18px;
    border: none;
    border-radius: 14px;
    background: var(--accent);
    color: #1a1206;
    font-family: "Space Grotesk", sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .01em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
    box-shadow: 0 12px 26px -12px rgba(232,163,61,.55);
  }

  .tune-btn:hover { transform: translateY(-1px); }
  .tune-btn:active { transform: translateY(0); }

  .tune-btn:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .tune-btn:disabled {
    opacity: .45;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .tune-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1a1206;
    flex: none;
  }

  .tune-btn.connecting .tune-dot {
    animation: pulse 0.9s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: .35; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tune-btn.connecting .tune-dot { animation: none; }
    .tune-btn { transition: none; }
  }

  .footnote {
    margin: 18px 6px 0;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
</head>
<body>

  <main class="stage">
    <div class="panel">
      <p class="eyebrow">التقط الجهاز</p>
      <h1>بوابة الجهاز</h1>
      <p class="lede">
        اكتب عنوان IP الظاهر الآن على شاشة الجهاز، ثم اضغط اتصال لفتح لوحة الإعدادات.
      </p>

      <form id="tuneForm" novalidate>
        <div class="dial-frame">
          <span class="dial-label" id="dialLabel">عنوان الجهاز على الشبكة</span>
          <div class="dial-row" role="group" aria-labelledby="dialLabel">
            <input class="octet" data-i="0" type="text" inputmode="numeric" maxlength="3"
                   autocomplete="off" aria-label="الجزء الأول من عنوان IP">
            <span class="dot" aria-hidden="true">.</span>
            <input class="octet" data-i="1" type="text" inputmode="numeric" maxlength="3"
                   autocomplete="off" aria-label="الجزء الثاني من عنوان IP">
            <span class="dot" aria-hidden="true">.</span>
            <input class="octet" data-i="2" type="text" inputmode="numeric" maxlength="3"
                   autocomplete="off" aria-label="الجزء الثالث من عنوان IP">
            <span class="dot" aria-hidden="true">.</span>
            <input class="octet" data-i="3" type="text" inputmode="numeric" maxlength="3"
                   autocomplete="off" aria-label="الجزء الرابع من عنوان IP">
            <span class="port-tag">:8080</span>
          </div>
        </div>
        <p class="hint" id="hint">كل جزء رقم بين 0 و255</p>

        <button type="submit" class="tune-btn" id="tuneBtn" disabled>
          <span class="tune-dot" aria-hidden="true"></span>
          <span id="tuneBtnLabel">اتصال</span>
        </button>
      </form>
    </div>

    <p class="footnote">
      يُحفَظ العنوان على جهازك فقط، ولا يُرسَل لأي خادم خارجي
    </p>
  </main>

<script>
(function () {
  "use strict";

  var PORT = "8080";
  var STORAGE_KEY = "device_portal_last_ip";

  var octets = Array.prototype.slice.call(document.querySelectorAll(".octet"));
  var form = document.getElementById("tuneForm");
  var btn = document.getElementById("tuneBtn");
  var btnLabel = document.getElementById("tuneBtnLabel");
  var hint = document.getElementById("hint");

  function octetValid(v) {
    if (!/^\d{1,3}$/.test(v)) return false;
    var n = parseInt(v, 10);
    return n >= 0 && n <= 255;
  }

  function currentValues() {
    return octets.map(function (el) { return el.value.trim(); });
  }

  function allValid() {
    return currentValues().every(octetValid);
  }

  function refreshState() {
    var vals = currentValues();
    octets.forEach(function (el, i) {
      var v = vals[i];
      if (v === "") { el.classList.remove("invalid"); return; }
      el.classList.toggle("invalid", !octetValid(v));
    });
    var ok = allValid();
    btn.disabled = !ok;
    hint.textContent = ok ? "جاهز — اضغط اتصال لفتح الإعدادات" : "كل جزء رقم بين 0 و255";
    hint.classList.toggle("error", vals.some(function (v) { return v !== "" && !octetValid(v); }));
  }

  function focusNext(i) {
    if (i < octets.length - 1) octets[i + 1].focus();
  }
  function focusPrev(i) {
    if (i > 0) octets[i - 1].focus();
  }

  octets.forEach(function (el, i) {
    el.addEventListener("input", function () {
      el.value = el.value.replace(/[^\d]/g, "").slice(0, 3);
      refreshState();
      if (el.value.length === 3) focusNext(i);
    });

    el.addEventListener("keydown", function (e) {
      if (e.key === "Backspace" && el.value === "") focusPrev(i);
      if (e.key === "." || e.key === " ") { e.preventDefault(); focusNext(i); }
    });

    el.addEventListener("paste", function (e) {
      var text = (e.clipboardData || window.clipboardData).getData("text");
      if (/^\d{1,3}(\.\d{1,3}){3}$/.test(text.trim())) {
        e.preventDefault();
        var parts = text.trim().split(".");
        octets.forEach(function (o, idx) { o.value = parts[idx]; });
        refreshState();
        octets[3].focus();
      }
    });
  });

  function buildUrl() {
    return "http://" + currentValues().join(".") + ":" + PORT + "/";
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!allValid()) return;

    var url = buildUrl();
    try { localStorage.setItem(STORAGE_KEY, currentValues().join(".")); } catch (err) {}

    btn.classList.add("connecting");
    btnLabel.textContent = "جارٍ الاتصال…";
    btn.disabled = true;

    setTimeout(function () { window.location.href = url; }, 350);
  });

  // استرجاع آخر عنوان محفوظ محلياً وتعبئته تلقائياً
  try {
    var saved = localStorage.getItem(STORAGE_KEY);
    if (saved && /^\d{1,3}(\.\d{1,3}){3}$/.test(saved)) {
      var parts = saved.split(".");
      octets.forEach(function (o, i) { o.value = parts[i]; });
    }
  } catch (err) {}

  refreshState();
  if (!octets[0].value) octets[0].focus();

  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("sw.js").catch(function () {});
    });
  }
})();
</script>
</body>
</html>
